# tools-panda · variables de entorno (plantilla sin secretos)
# Desarrollo: copiar a .env.local. Producción: cargarlas en Vercel. Paso a paso: SETUP-SUPABASE.md
#
# Sin las tres de Supabase, en desarrollo la app corre en MODO LOCAL (datos en .data/, sin mails:
# el link de acceso se muestra en pantalla). En producción sin ellas, no arranca.

# ── Supabase de Panda (proyecto propio, separado del de Bardo) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# secreta: solo servidor. Nunca en el navegador ni en el repo.
SUPABASE_SERVICE_ROLE_KEY=

# ── URL pública: links de los mails y Open Graph. En local: http://localhost:3000 ──
SITE_URL=

# ── Opcional: aviso al equipo cuando el cliente cierra el feedback (webhook de n8n) ──
AVISO_WEBHOOK_URL=
